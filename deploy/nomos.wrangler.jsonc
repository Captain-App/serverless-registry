{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "nomos-kernel-registry",
  "account_id": "a74f1bc4e551eedf640c64223476ce7e",
  "main": "../index.ts",
  "compatibility_date": "2024-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "registry.nomos.cafe",
      "custom_domain": true,
    },
  ],
  "r2_buckets": [
    {
      "binding": "REGISTRY",
      "bucket_name": "nomos-kernel-registry",
    },
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "PUSH_COMPATIBILITY_MODE": "none",
  },
}
